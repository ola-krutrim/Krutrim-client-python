# cloud (default) or cloudx
KRUTRIMCLIENT_ENVIRONMENT=cloud

# Use an API key from the selected environment, or sign in through client.iam.
KRUTRIMCLIENT_API_KEY=
KRUTRIM_REGION=In-Hyderabad-1

# Required only for root-user login
KRUTRIM_EMAIL=
KRUTRIM_PASSWORD=

# Optional custom endpoint; omit KRUTRIMCLIENT_ENVIRONMENT when using this.
# KRUTRIMCLIENT_BASE_URL=https://your-private-endpoint.example.com
